# ===========================================================================
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# `.env` is git-ignored. `.env.example` is committed so other developers
# (and future-you) know which variables the app expects.
# ===========================================================================

# --- LLM (Groq) -----------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Model used by the agent. Must support tool calling.
GROQ_MODEL=llama-3.3-70b-versatile

# 0.0 = deterministic. For customer support we want low creativity.
LLM_TEMPERATURE=0.0

# Safety valve: cap the response length.
LLM_MAX_TOKENS=1024


# --- Embeddings -----------------------------------------------------------
# Small, fast, runs locally on CPU. 384-dimensional vectors.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# --- Retrieval ------------------------------------------------------------
# How big each document chunk is, in characters.
CHUNK_SIZE=800
# How much neighbouring chunks overlap, so we don't cut a sentence in half.
CHUNK_OVERLAP=120
# How many chunks the retriever hands to the LLM per question.
RETRIEVER_TOP_K=4


# --- Paths ----------------------------------------------------------------
KNOWLEDGE_BASE_DIR=data/knowledge_base
VECTOR_STORE_DIR=data/vector_store
DATABASE_URL=sqlite:///database/customer_support.db


# --- App ------------------------------------------------------------------
APP_NAME=AI Customer Support Knowledge Agent
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
